# Zkopírujte jako .env (nebo nastavte tyto proměnné jinak, viz README) a NIKDY nekomitujte skutečné hodnoty.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# --- Google OAuth2 / OIDC ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Autorizace (Google "sub" hodnoty, csv) ---
# Zatím prázdné - doplní se po prvním přihlášení obou účtů (viz "discovery mode" v implementačním plánu).
ALLOWED_GOOGLE_SUBS=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
